<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Frida 编排 daemon(dh_frida):连 frida-server + spawn/attach 目标 App 注入 JS。
         越狱 AMFI 不校验来源,fake 签也认;实测这组 entitlement 下 spawn+resume+attach+inject 全通。 -->
    <key>platform-application</key><true/>
    <key>com.apple.private.security.container-required</key><false/>
    <key>task_for_pid-allow</key><true/>
    <key>get-task-allow</key><true/>
    <key>com.apple.system-task-ports</key><true/>
    <key>dynamic-codesigning</key><true/>
</dict>
</plist>
